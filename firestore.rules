rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Qualquer pessoa pode ENVIAR um lead, mas só o administrador logado consegue ler; ninguém altera ou apaga pelo site.
    match /leads/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nome','telefone','campo','idade','missao','data','criadoEm'])
                    && request.resource.data.nome is string && request.resource.data.nome.size() <= 120
                    && request.resource.data.telefone is string && request.resource.data.telefone.size() <= 20
                    && request.resource.data.campo is string && request.resource.data.campo.size() <= 120
                    && request.resource.data.idade is number && request.resource.data.idade >= 5 && request.resource.data.idade <= 99
                    && request.resource.data.missao is string && request.resource.data.missao.size() <= 160;
      // Somente o administrador (login em admin.html) pode ler a lista.
      allow read: if request.auth != null && request.auth.token.email == 'admin@leadstogether.com';
      allow update, delete: if false;
    }
  }
}
